# Copy this file to `.env` and adjust the values.
# `.env` is gitignored and must never be committed.

# API base URL (the api-gateway). If unset, dev derives it from the Metro host
# (`http://<metro-host>:8080`) and production uses the hardcoded default below.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080

# ms-sensor-management requires `sensorModelId` and `sensorStatusId` (UUIDs) to
# register a sensor and exposes no catalog endpoint for them yet. Until it does,
# provisioning cannot complete without these two values.
# EXPO_PUBLIC_SENSOR_MODEL_ID=
# EXPO_PUBLIC_SENSOR_STATUS_ID=
